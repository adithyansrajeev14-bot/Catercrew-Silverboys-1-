# ==============================================================================
# CaterCrew Environment Configuration Template (.env.example)
# Do NOT store real credentials in this file. Copy to .env and fill in values.
# ==============================================================================

# -------------------------------------------------------------
# 1. Supabase (Database, Auth & Storage)
# -------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -------------------------------------------------------------
# 2. Step 1: SMS Gateway (Choose MSG91 or Twilio - Mock mode used if blank)
# -------------------------------------------------------------
# MSG91 Configuration (Preferred for India DLT SMS delivery)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=CATCRW

# Twilio Configuration (Alternative SMS Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Secret salt for hashing stored OTPs before database persistence
OTP_SALT_SECRET=catercrew_secure_otp_salt_change_in_production

# -------------------------------------------------------------
# 3. Step 2: Aadhaar Identity Provider (DigiLocker / Surepass / IDfy / Digio)
# MockProvider is used automatically when SUREPASS_API_TOKEN is not set.
# -------------------------------------------------------------
SUREPASS_API_TOKEN=
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1

# Alternative: Digio eKYC credentials
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=

# Salt for hashing UIDAI provider reference for duplicate account detection (DPDP Act 2023)
AADHAAR_SALT_SECRET=catercrew_aadhaar_ref_salt_change_in_production

# -------------------------------------------------------------
# 4. Step 3: Facial Biometrics & Liveness Provider (IDfy / AWS Rekognition)
# MockFaceProvider is used automatically when IDFY_API_KEY is not set.
# -------------------------------------------------------------
IDFY_API_KEY=
IDFY_ACCOUNT_ID=

# -------------------------------------------------------------
# 5. Client Authentication & Port
# -------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=
PORT=3000
NODE_ENV=development